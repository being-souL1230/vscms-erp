{
  "expo": {
    "name": "VSCMS ERP",
    "slug": "vscms-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a237e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vscms.erp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a237e"
      },
      "package": "com.vscms.erp"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-asset"
    ]
  }
}
